{
  "name": "bubu-desktop-companion",
  "version": "2.0.0",
  "private": true,
  "description": "Bubu Desktop Companion - Animated Desktop Pet and Control Center",
  "author": "Bubu Team",
  "main": "apps/desktop-pet/dist/main/main.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "test": "node --test tests/",
    "package:linux": "electron-builder --linux",
    "package:win": "electron-builder --win",
    "package:mac": "electron-builder --mac",
    "package": "npm run package:linux && npm run package:win"
  },
  "allowScripts": {
    "esbuild": true,
    "electron@29.4.6": true,
    "esbuild@0.21.5": true
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "typescript": "^5.2.2",
    "vite": "^5.4.1"
  }
}
