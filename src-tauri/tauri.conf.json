{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "bubu",
  "version": "6.0.0",
  "identifier": "com.bubu.companion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bubu Control Center",
        "url": "/",
        "width": 900,
        "height": 700,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "pet",
        "title": "Bubu",
        "url": "/pet.html",
        "width": 300,
        "height": 300,
        "x": 100,
        "y": 100,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
